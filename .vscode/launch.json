    "version": "0.2.0",
    "configurations": [
        {
            "name": "portal-frontend (web :5000)",
            "request": "launch",
            "type": "dart",
            "deviceId": "chrome",
            "args": [
                "--web-port=5000",
                "--web-hostname=localhost"
            ]
        },
        {
            "name": "portal-frontend",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "portal-frontend (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "portal-frontend (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}